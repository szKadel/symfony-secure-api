{
  "name": "kadello/symfony-secure-api",
  "description": "Security-minded REST API built with Symfony",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "symfony/framework-bundle": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/yaml": "^7.4",
    "symfony/console": "^7.4",
    "symfony/string": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "scripts": {"test": "phpunit"},
  "config": {"allow-plugins": {"symfony/runtime": true}}
}
